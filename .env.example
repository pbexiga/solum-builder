# Copy to `.env` and edit. Used by `docker compose` and when running from source.

# Your circuits, blocks, models, clips, .nam files. BACK THIS UP.
# Point this at a folder you back up.
DATA_DIR=./data

# Search index and simulation/render cache. Safe to delete.
# Must be on a local disk, never a network share (SQLite locking).
CACHE_DIR=./cache

# Largest the simulation cache may grow, in GB; oldest results are dropped first.
CACHE_MAX_GB=2

# Port the web app is served on.
PORT=8000

