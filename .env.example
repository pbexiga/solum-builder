# Optional: Solum Builder runs without a `.env`. Copy this to `.env` and edit it only to
# keep things in other folders or to use another port. Used by `docker compose` and when
# running from source.

# Your circuits, blocks, models, clips, .nam files. BACK THIS UP.
DATA_DIR=./data

# Search index and simulation/render cache. Safe to delete.
# Must be on a local disk, never a network share (SQLite locking).
CACHE_DIR=./cache

# Port the web app is served on.
PORT=8000

# The largest cache size is set in the app (File → Settings…). CACHE_MAX_GB here (2 if
# left out) only holds until it has been set there.
