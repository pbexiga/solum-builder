{
  "sources": {
    "ltspice": {
      "why": "The maker's card, but the copy published is inside LTspice's library, which Analog Devices marks all rights reserved, so it can't be passed on with the app (D-156).",
      "get": "the file {file} from KiCad-Spice-Library (the copy this app's cards were checked against)"
    },
    "ltspice-no-maker": {
      "why": "The card names no maker, so it belongs to the library it was published in: LTspice's, which Analog Devices marks all rights reserved (D-152, D-156).",
      "get": "the file {file} from KiCad-Spice-Library (the copy this app's cards were checked against)"
    },
    "intusoft": {
      "why": "The card comes from Intusoft's library, marked all rights reserved (D-151, D-156).",
      "get": "the file {file} from KiCad-Spice-Library (the copy this app's cards were checked against)"
    },
    "electrosmash": {
      "why": "ElectroSmash publishes it for non-commercial use only (CC BY-NC 3.0); the app ships only cards anyone may pass on for any use (D-156).",
      "get": "ElectroSmash's Fuzz Face analysis page, which prints the card: copy its .model line into a text file (for example AC128.lib)"
    },
    "ti-tlc2262": {
      "why": "TI's terms for this download don't say whether it may be passed on (D-156); our own TLC2262, fitted to TI's sheet, ships instead.",
      "get": "{file} from TI's TLC2262 page"
    },
    "national-lm13700": {
      "why": "Free to pass on, but our own LM13700 ships instead: National's card is single-pole, so its own header warns it overstates bandwidth and phase margin by over 2×, and it has a 0.6 mV input offset (D-183).",
      "get": "{file} from TI's LM13700 page"
    }
  },
