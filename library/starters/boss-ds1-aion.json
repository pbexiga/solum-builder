 "texts": [
  {
   "title": "Credit",
   "text": "Based on Aion FX's Comet (document 1.1.0): its circuit, values and build ideas.\nThe drawing, notes and wording are Solum Builder's own.\nhttps://aionfx.com/project/comet-vintage-distortion/",
   "pos": [
    -40,
