 "texts": [
  {
   "title": "Source",
   "pos": [
    -60,
    520
   ],
   "text": "Drawn from ElectroSmash's \"Klon Centaur Analysis\" (schematic and parts,\npart numbers as there). SW1 is drawn at effect on: the Level wiper goes\nstraight to the output, so R242 (across SW1 then) isn't drawn.\nhttps://www.electrosmash.com/klon-centaur-analysis"
  }
 ],
 "notes": {
  "part:R1": "Protects the input buffer from static on the input jack.",
  "part:U1A": "Input buffer: R2 biases it at VR, so the guitar sees about 1M.",
  "part:VR1A": "Gain, first gang: it sets the gain stage's gain, from about 0 dB to 40 dB, the most around 1 kHz.",
  "part:VR1B": "Gain, second gang: it turns the second clean path down as the first gang turns the gain up, so the mix of clean and clipped stays balanced.",
  "part:D2": "D2 and D3 clip the gain stage's output to ground: germaniums, at about 0.35 V, a soft knee.",
  "part:C16": "With R7, the first clean path's low-pass (about 106 Hz): it adds low end under the clipped signal.",
  "part:U2A": "Summing amp: adds the clipped signal and both clean paths; R20 and C13 roll it off above about 500 Hz. It runs from VB to -VA, so it has 27 V of headroom.",
  "part:VR2": "Treble: a shelf above about 400 Hz, from about -8 dB to +18 dB, flat in the middle.",
  "part:U3": "Charge pump: doubles V+ through D7 and D8 for VB, and inverts it for -VA, both at once. Pin 1 on V+ is the MAX1044's boost, which raises its switching frequency.",
  "part:D4": "A 12 V zener across the supply: it conducts only if too much voltage is plugged in, protecting the charge pump.",
  "part:R243": "The buffered bypass signal reaches the output through R243 even with the effect on (ElectroSmash: \"around 1dB\"). Simulated, it lowers the output by 0.1 to 0.3 dB: the summing amp turns the effect upside down, so the clean bleed takes a little off it. With the pedal off, R242 lets the effect into the clean signal the same way.",
  "part:R29": "R29 and R30 halve the supply for VR, the 4.5 V the op-amps are biased at."
 },
 "probes": {
  "in": "in",
  "out": "out"
 },
 "enclosure": {
  "size": "125B"
 }
