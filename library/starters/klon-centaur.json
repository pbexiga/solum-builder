{
 "schema": 29,
 "id": "klon-centaur",
 "name": "Klon Centaur",
 "version": {
  "major": 1,
  "minor": 0
 },
 "description": "Klon Centaur Professional Overdrive (1994) as ElectroSmash's analysis draws it: an input buffer, then a dual Gain pot that turns up a gain stage clipping into two 1N34A germaniums while it turns down two clean paths; a summing amp adds them, then Treble and Level. A MAX1044 doubles and inverts the 9 V to about 16 V and -8.6 V for the summing and treble amps. The buffered bypass path stays connected through R243, as in the pedal; the footswitch is drawn at effect on.",
 "tags": [
  "overdrive"
 ],
 "starter": true,
 "power": {
  "rails": {
   "V+": 9.0
  }
 },
