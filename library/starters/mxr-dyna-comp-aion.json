 "texts": [
  {
   "title": "Credit",
   "text": "Based on Aion FX's Aurora (document 2.0.0): its circuit, values and build ideas.\nThe drawing, notes and wording are Solum Builder's own.\nhttps://aionfx.com/project/aurora-compressor-sustainer/",
   "pos": [
    -40,
    380
   ]
  }
 ],
 "notes": [
  {
   "title": "Try: the stock Ross/Dyna output",
   "text": "The stock Ross/Dyna output: CX1 47n from Q2's emitter to R25, with Q6 and R22-R24 left out (that lets a little ripple onto the signal, heard as slight distortion). (from Aion FX's Aurora notes)"
  },
  {
   "title": "Release fully down",
   "text": "Release fully down matches the stock circuit; with a true 150kC pot, R19 can go. (from Aion FX's Aurora notes)"
  },
  {
   "title": "Treble switch",
   "text": "Treble switch: up (C11 1n with C10) is stock and flat, down (C12 510p) slightly brighter, middle (C10 alone) brightest and a bit noisier. (from Aion FX's Aurora notes)"
  },
  {
   "title": "Try: C17 across R25",
   "text": "C17 1n across R25 lifts the treble above 3 kHz (1n5: from 2.2 kHz); leave it out for the stock sound. (from Aion FX's Aurora notes)"
  },
  {
   "title": "Try: C1 at the input",
   "text": "C1 220p from the input to ground (the Keeley has 150p). (from Aion FX's Aurora notes)"
  },
  {
   "title": "Stock pots and the legacy board",
   "text": "Stock pots: Sustain 500kB, Level 50kB. Aion's legacy Aurora board takes a CA3080 instead of the LM13700. (from Aion FX's Aurora notes)"
  }
 ],
 "probes": {
  "in": "in",
  "out": "out"
 },
 "net_notes": {
  "VB": "About a third of the supply: the OTA's output bias and Q1's."
 },
 "enclosure": {
  "size": "125B"
 }
}
