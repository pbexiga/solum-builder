 "id": "mxr-dyna-comp-aion",
 "name": "MXR Dyna Comp (Aion Aurora)",
 "version": {
  "major": 1,
  "minor": 0
 },
 "description": "MXR Dyna Comp (1972) and Ross Compressor as Aion FX's Aurora (document 2.0.0), with true bypass: an input buffer, an OTA whose gain the envelope sets, a phase splitter feeding a full-wave envelope detector, and Aion's output buffer. Sustain sets how hard it compresses, Release (from the Boss CS-2, which calls it Attack) how fast it recovers, Level the output; Aion's Treble switch picks the treble cut after the OTA. The LM13700 as Aion uses it in place of the CA3080.",
 "tags": [
  "compressor"
 ],
 "starter": true,
 "power": {
  "rails": {
   "V+": 9.0
  }
 },
