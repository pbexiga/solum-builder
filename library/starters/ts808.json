  "notes": {
    "net:VREF": "4.5 V bias from the R33/R32 divider, decoupled by C16.",
    "net:q1e": "Input buffer output: an emitter follower, gain about 1.",
    "net:u2o": "Clipping amplifier output: diodes D1/D2 in the feedback loop clip it softly.",
    "part:C3": "With R4, a high-pass in the feedback leg (about 720 Hz): bass gets less gain and less distortion.",
    "part:C4": "51 pF across the diodes: a low-pass that softens the clipping, strongest at full Distortion.",
    "part:C5": "With R8, a passive low-pass (about 723 Hz) after the clipper: the mid hump."
  },
  "enclosure": {
    "size": "125B"
  }
